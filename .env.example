DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
AUTH_SECRET="generate-with-npx-auth-secret"
ALLOWED_EMAIL_DOMAIN="miliopay.com"

# Servidor de sockets de Trivias (server/trivia-server.ts), proceso aparte
TRIVIA_SOCKET_PORT="4001"
# Dev: http://localhost:4001 — Producción (detrás de nginx en el mismo dominio): deja la ruta relativa "/socket.io" o la URL pública del dominio
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"

# Servidor de sockets de Cocina Loca (server/cocina-server.ts), proceso aparte
COCINA_SOCKET_PORT="4002"
# Dev: http://localhost:4002 — Producción: la URL pública del sitio, nginx enruta /cocina-socket.io al mismo origen
NEXT_PUBLIC_COCINA_SOCKET_URL="http://localhost:4002"
