# Copiar a /etc/nginx/sites-available/activity y enlazar con:
#   sudo ln -s /etc/nginx/sites-available/activity /etc/nginx/sites-enabled/activity
#   sudo nginx -t && sudo systemctl reload nginx
# Luego correr certbot para HTTPS (ver DEPLOY.md).

server {
    listen 80;
    server_name teambuilding.milio.com.co;

    # App Next.js
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Servidor de sockets de Trivias (WebSocket)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
